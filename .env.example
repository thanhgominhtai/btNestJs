# =================================================================
# CẤU HÌNH HỆ THỐNG STARBUCKS RECIPE BACKEND
# =================================================================

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=ClusterTuiTenTai
PORT=3000
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:4200

# =================================================================
# CẤU HÌNH GỬI EMAIL OTP (CHỌN 1 TRONG 2 CÁCH)
# =================================================================

# CÁCH 1: Gửi qua Resend (Khuyên dùng - Miễn phí 3.000 mail/tháng)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key_here
SMTP_FROM=no-reply@tsmile.id.vn

# CÁCH 2: Gửi qua Gmail Cá nhân (Dùng Mật khẩu ứng dụng Google App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_google_app_password
# SMTP_FROM=your_email@gmail.com



